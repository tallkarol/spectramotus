# Spectramotus - copy to .env (never committed). Leave a key empty to disable that provider.

# fal.ai: Wan 2.2 Animate (default body-motion provider), Kling 3.0 Motion Control, Nano Banana Pro edit
FAL_KEY=

# Anthropic: Claude photo analysis (intake) and clip QA
ANTHROPIC_API_KEY=

# Google AI Studio: Nano Banana Pro direct (optional; the fal route works without it)
GOOGLE_API_KEY=

# Runway: Act-Two motion-transfer provider (optional, for bake-offs)
RUNWAYML_API_SECRET=

# Hugging Face: only for higher download rate limits (BiRefNet weights are public)
HUGGINGFACE_API_KEY=

# ClipDrop: legacy clean-plate fallback only
CLIPDROP_API_KEY=

# Pipeline defaults
SPECTRAMOTUS_BUDGET_USD=8
SPECTRAMOTUS_CANVAS=portrait
